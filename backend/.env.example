# Copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB Atlas connection string ───────────────────────────────────────────
MONGO_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/eletrack-ai?retryWrites=true&w=majority

# ── JWT Secret ────────────────────────────────────────────────────────────────
JWT_SECRET=eletrack_ai_secure_secret_key_2026

# ── Frontend CORS (no trailing slash) ─────────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app

# ── RF Monitoring (Python service on Jetson) ──────────────────────────────────
# URL where the Python FastAPI RF service is running
RF_SERVICE_URL=http://localhost:8001

# Detection threshold in dBm (signals above this = INTRUSION)
RF_THRESHOLD_DBM=-40

# Center frequency in Hz (915 MHz = ISM band used by walkie-talkies)
RF_CENTER_FREQ_HZ=915000000

# Frequency span in Hz
RF_SPAN_HZ=50000000

# How often to scan (seconds)
RF_SCAN_INTERVAL_SEC=5

# VISA/USB address for Rigol DSA832E — find with: python -c "import pyvisa; rm=pyvisa.ResourceManager(); print(rm.list_resources())"
VISA_RESOURCE=USB0::0x1AB1::0x0960::DSA832-XXXXXXXX::INSTR

# Set to "true" to run without hardware (generates simulated RF data)
RF_SIMULATE=false
