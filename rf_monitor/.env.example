"""
rf_monitor/.env.example
=======================
Copy this file to rf_monitor/.env (or place in project root) and fill in values.
"""
# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/eletrack-ai?retryWrites=true&w=majority
MONGO_DB=eletrack-ai

# ── Node.js Backend ───────────────────────────────────────────────────────────
NODE_BACKEND_URL=http://localhost:5000

# ── JWT (must match Node.js JWT_SECRET) ──────────────────────────────────────
JWT_SECRET=eletrack_ai_secure_secret_key_2026

# ── Rigol DSA832E (VISA/USB) ──────────────────────────────────────────────────
# Find with: python -c "import pyvisa; m=pyvisa.ResourceManager(); print(m.list_resources())"
VISA_RESOURCE=USB0::0x1AB1::0x0960::DSA832-XXXXXXXX::INSTR

# ── Frequency Configuration ───────────────────────────────────────────────────
RF_CENTER_FREQ_HZ=915000000    # 915 MHz ISM — walkie-talkie / LoRa band
RF_SPAN_HZ=50000000            # 50 MHz span
RF_RBW_HZ=100000               # Resolution bandwidth
RF_VBW_HZ=100000               # Video bandwidth

# ── Detection Threshold ───────────────────────────────────────────────────────
RF_THRESHOLD_DBM=-40           # dBm — signals above = INTRUSION
RF_SCAN_INTERVAL_SEC=5         # seconds between sweeps

# ── FastAPI Port ──────────────────────────────────────────────────────────────
RF_API_PORT=8001

# ── Simulation Mode (no hardware needed for testing) ─────────────────────────
RF_SIMULATE=false
